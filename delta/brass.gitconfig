# Brass for delta (the git diff pager), part of cosmic-brass-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat Brass theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/brass.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = brass

[delta "brass"]
    dark = true
    syntax-theme = Brass
    navigate = true
    line-numbers = true

    file-style = bold "#D4BD99"
    file-decoration-style = "#6B655C" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#6B655C" box
    hunk-header-file-style = "#A89984"
    hunk-header-line-number-style = "#EBDBB2"

    minus-style = "#DD6A5C" "#232220"
    minus-emph-style = bold "#1C1B19" "#DD6A5C"
    minus-non-emph-style = "#DD6A5C" "#232220"
    plus-style = "#C2A571" "#232220"
    plus-emph-style = bold "#1C1B19" "#C2A571"
    plus-non-emph-style = "#C2A571" "#232220"
    zero-style = syntax
    whitespace-error-style = "#1C1B19" "#E0905C"

    line-numbers-left-style = "#6B655C"
    line-numbers-right-style = "#6B655C"
    line-numbers-minus-style = "#DD6A5C"
    line-numbers-plus-style = "#C2A571"
    line-numbers-zero-style = "#6B655C"

    commit-style = bold "#EBDBB2"
    commit-decoration-style = "#6B655C" box
    blame-palette = "#1C1B19 #232220 #2C2925"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#C2A571"
    merge-conflict-theirs-diff-header-style = bold "#E0905C"
